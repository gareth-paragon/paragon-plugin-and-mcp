# Copy to repo root as `.env.local` (gitignored). Loaded by `scripts/run-mcp.cmd`
# and convert/OCR scripts. Do not commit real machine paths.

PARAGON_CURSOR_DOCS_ROOT=C:/path/to/cursor-test
PARAGON_PARADOCS_REPO=C:/path/to/Technical Documentation
PARAGON_TECH_ARCH_SOURCE=C:/path/to/SharePoint/Technical Architecture - Documents
PARAGON_TECH_ARCH_CORPUS=C:/path/to/Technical Documentation/corpus/tech-arch

# Optional. When set, this replaces the default tech-arch + abbey-view tree list.
# Include every tree corpus you want loaded (semicolon-separated id=path).
# PARAGON_CURSOR_CORPORA=tech-arch=C:/path/to/Technical Documentation/corpus/tech-arch;abbey-view=C:/path/to/Technical Documentation/corpus/abbey-view;drupal-docs=C:/path/to/drupal-docs
