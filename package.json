{
  "name": "paradocs-mcp",
  "version": "0.2.1",
  "private": true,
  "description": "ParaDOCS convert MCP with bundled Word/PDF engine and MCP Apps chrome.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "esbuild src/convert/index.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/index.js",
    "build:server:knowledge": "esbuild src/knowledge/index.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/knowledge/index.js",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/index.js",
    "dev": "tsx src/convert/index.ts",
    "dev:knowledge": "tsx src/knowledge/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.mts",
    "sync:style": "python scripts/sync_paragon_markdown_style.py",
    "sync:style:check": "python scripts/sync_paragon_markdown_style.py --check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "cursor",
    "paragon",
    "paradocs",
    "convert",
    "documentation"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
